# Ejecuta npm run setup; el asistente crea .env y genera las claves locales.
# Nunca guardes aquí claves reales en Git ni uses datos notariales reales en testnet.

NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:3001

# SQLite local; no requiere instalar base de datos ni Docker.
DATABASE_URL=file:../notaria.db

# El asistente genera una contraseña segura y la muestra una sola vez.
INITIAL_ADMIN_EMAIL=admin@notaria.local
INITIAL_ADMIN_NAME=Administrador de la notaría
INITIAL_ADMIN_PASSWORD=@M10112019_n

# Genera secretos aleatorios seguros; no reutilices valores de ejemplo.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET= dYhx2hcwXGMmpZPoutQUfJAM-eT3SxlD9esa24BTYGQ-nPX-uDoWyNHo0GfWcw6z
# AES-256: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_STORAGE_PATH=./private-storage
MAX_UPLOAD_MB=20

# Blockchain EVM. Sin configurar red+contrato+firmante, no se afirma que el
# documento quedó anclado en cadena; se guarda el estado PENDING/FAILED en BD.
CHAIN_RPC_URL=https://testnet.hsk.xyz
CHAIN_ID=133
NOTARY_REGISTRY_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
