# Normaliza saltos de linea: el repo SIEMPRE guarda LF (Git lo gestiona en Windows).
* text=auto eol=lf

# YAML: LF
*.yml       text eol=lf
*.yaml      text eol=lf

# Scripts que se ejecutan en Windows: conservan CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binarios: nunca tocar
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.sqlite    binary
*.zip       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
