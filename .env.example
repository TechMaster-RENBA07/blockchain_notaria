APP_NAME="Blockchain Notaría"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Base de datos PostgreSQL local.
# ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestor_notaria
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ---------------------------------------------------------------
# Correo: Mailpit local. Atrapa los correos en http://localhost:8025
# No envia nada a internet, no cuesta nada.
# (Binario en C:\tools\mailpit o cualquier ruta en el PATH)
# ---------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@notaria.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Blockchain
#   simulated = cadena propia en la base de datos (por defecto)
#   ethereum  = nodo local (por ejemplo Ganache en el puerto 8545)
# ---------------------------------------------------------------
BLOCKCHAIN_DRIVER=simulated
BLOCKCHAIN_DIFFICULTY=2
BLOCKCHAIN_AUTO_ANCHOR=true

ETHEREUM_RPC_URL=http://127.0.0.1:8545
ETHEREUM_CHAIN_ID=1337
ETHEREUM_ACCOUNT=
ETHEREUM_PRIVATE_KEY=
ETHEREUM_CONTRACT_ADDRESS=

# ---------------------------------------------------------------
# Firma digital
# ---------------------------------------------------------------
SIGNING_KEY_PATH=storage/keys
SIGNING_KEY_BITS=2048
SIGNING_KEY_VALIDITY_DAYS=1825
